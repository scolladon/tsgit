    "check:filesystem": {
      "command": "ls-lint",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        ".ls-lint.yml"
      ],
      "output": []
    },
    "check:deps": {
      "command": "sh -c 'npm outdated || ! npm outdated 2>/dev/null | tail -n +2 | grep -v \"^@ls-lint/ls-lint \" | grep -v \"^typescript \" | grep -v \"^knip \" | grep -v \"^jscpd \" | grep -v \"^vitest \" | grep -v \"^@vitest/coverage-v8 \" | grep -v \"^@cloudflare/workers-types \" | grep -q .'",
      "files": [
        "package.json",
        "package-lock.json"
      ],
      "output": []
    },
    "test": {
      "command": "vitest run",
