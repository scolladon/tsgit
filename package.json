  "wireit": {
    "build": {
      "dependencies": [
        "build:js"
      ]
    },
    "build:js": {
      "command": "rollup -c rollup.config.ts --configPlugin @rollup/plugin-typescript && node --experimental-strip-types tooling/truthful-dts.ts",
      "dependencies": [
        "check:types"
      ],
      "files": [
        "src/**/*.ts",
        "rollup.config.ts",
        "tsconfig.build.json",
        "package.json",
        "tooling/dts-entries.ts",
        "tooling/dts-value-exports.ts",
        "tooling/truthful-dts.ts"
      ],
      "output": [
        "dist/esm/**",
        "dist/cjs/**",
        "dist/types/**",
        "dist/browser/**"
      ],
      "clean": "if-file-deleted"
    },
    "build:profile": {
      "command": "rollup -c rollup.profile.config.ts --configPlugin @rollup/plugin-typescript",
      "files": [
        "src/**/*.ts",
        "rollup.profile.config.ts",
        "tsconfig.build.json"
      ],
      "output": [
        "dist-profile/esm/**"
      ],
      "clean": "if-file-deleted"
    },
    "check": {
      "command": "biome check .",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "tooling/**/*.ts",
        "biome.json"
      ],
      "output": []
    },
    "check:fix": {
      "command": "biome check --write .",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "biome.json"
      ],
      "output": []
    },
    "check:types": {
      "command": "tsc --noEmit -p tsconfig.typecheck.json",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "tooling/**/*.ts",
        "tsconfig.json",
        "tsconfig.typecheck.json"
      ],
      "output": []
    },
    "check:dead-code": {
      "command": "knip",
      "files": [
        "src/**/*.ts",
        "knip.json",
        "package.json"
      ],
      "output": []
    },
    "check:duplicates": {
      "command": "jscpd src/",
      "files": [
        "src/**/*.ts",
        ".jscpd.json"
      ],
      "output": []
