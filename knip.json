{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts",
    "src/index.default.ts",
    "src/index.node.ts",
    "src/public-types.ts",
    "src/repository.ts",
    "src/adapter-detect.ts",
    "src/dispose-adapters.ts",
    "src/progress.ts",
    "src/domain/index.ts",
    "src/application/index.ts",
    "src/ports/index.ts",
    "src/adapters/index.ts",
    "src/adapters/node/index.ts",
    "src/adapters/browser/index.ts",
    "src/adapters/memory/index.ts",
    "src/application/commands/index.ts",
    "src/application/primitives/index.ts",
    "src/operators/index.ts",
    "src/transport/index.ts"
  ],
  "project": ["src/**/*.ts"],
  "ignore": ["test/runtime-parity/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["@cloudflare/workers-types", "expect-type", "wrangler"],
  "ignoreBinaries": ["gpg", "lychee"],
  "vitest": {
    "config": ["vitest.config.ts"]
  }
}
