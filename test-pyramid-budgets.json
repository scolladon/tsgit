{
  "$schema": "./tooling/test-pyramid-budgets-schema.json",
  "tiers": [
    {
      "name": "unit",
      "glob": "{test,tooling/test}/unit/**/*.test.ts",
      "target": 80,
      "warnBelow": 75,
      "warnAbove": null
    },
    {
      "name": "integration",
      "glob": "{test,tooling/test}/integration/**/*.test.ts",
      "target": 15,
      "warnBelow": 10,
      "warnAbove": 25
    },
    {
      "name": "e2e",
      "glob": "test/browser/**/*.spec.ts",
      "target": 5,
      "warnBelow": 3,
      "warnAbove": null
    },
    {
      "name": "parity",
      "glob": "test/parity/**/*.test.ts",
      "target": 0,
      "warnBelow": 0,
      "warnAbove": null
    },
    {
      "name": "runtime-parity",
      "glob": "test/runtime-parity/**/*.test.ts",
      "target": 0,
      "warnBelow": 0,
      "warnAbove": null
    },
    {
      "name": "perf",
      "glob": "test/perf/**/*.test.ts",
      "target": 0,
      "warnBelow": 0,
      "warnAbove": null
    }
  ],
  "heuristics": {
    "overMockedIntegration": {
      "tier": "integration",
      "regex": "\\bvi\\.(mock|fn|spyOn|stubGlobal|stubEnv)\\s*\\(",
      "threshold": 0
    },
    "underAssertedUnit": {
      "tiers": ["unit", "integration", "parity", "runtime-parity", "perf"],
      "minAssertionsPerTest": 1
    },
    "gwtTitle": {
      "tiers": ["unit", "integration", "parity", "runtime-parity", "perf"],
      "describeGiven": "^Given .+$",
      "describeWhen": "^When .+$",
      "describeCombined": "^Given .+?, When .+$",
      "itThen": "^Then .+$",
      "legacyItGwt": "^Given .+?, When .+?, Then .+$"
    },
    "aaaBody": {
      "tiers": ["unit", "integration", "parity", "runtime-parity", "perf"],
      "required": ["Arrange", "Assert"]
    },
    "sutNaming": {
      "tiers": ["unit", "integration", "parity", "runtime-parity", "perf"],
      "banned": ["subject", "objectUnderTest", "systemUnderTest", "cut"]
    },
    "bareClassToThrow": {
      "tiers": ["unit", "integration", "parity", "runtime-parity", "perf"],
      "regex": "\\.toThrow(?:Error)?\\s*\\(\\s*([A-Z]\\w*)\\s*\\)"
    },
    "emptyAaaSection": {
      "tiers": ["unit", "integration", "parity", "runtime-parity", "perf"]
    },
    "sutBindsResult": {
      "tiers": ["unit", "integration", "parity", "runtime-parity", "perf"],
      "allowlist": [
        "openRepository",
        "createNodeContext",
        "createMemoryContext",
        "createContext",
        "asWorktreeChild",
        "buildSeededContext",
        "seedRepo",
        "open",
        "openUnavailable",
        "openGitSession",

        "createCachingIndexResolver",
        "createFsWorkdirEnumerator",
        "createCachingTreeResolver",
        "createRawIndexResolver",
        "createSingleFlightIndexResolver",
        "createRawTreeResolver",
        "createPackRegistry",
        "createRefStore",
        "acquireIndexLock",
        "createWorkdirEntry",
        "createIndexEntry",
        "createTreeEntry",
        "createTreeSnapshot",
        "createIndexSnapshot",
        "createWorkdirSnapshot",
        "createStashSnapshot",
        "createGranularityTracker",
        "createByteGranularityTracker",
        "createCounterGenerationView",
        "createInMemoryWriteEventBus",
        "createConcurrencyLimiter",

        "withRetry",
        "withLogging",
        "withAuth",
        "withDefaults",
        "wrapFsValidator",
        "wrapTransportValidator",
        "wrapLoggerSanitizer",
        "factoryFor",
        "buildContentMerger",
        "buildGrepMatcher",
        "buildRefFilter",
        "buildSparseMatcher",
        "buildRepoIgnorePredicate",
        "buildIgnoreEvaluator",
        "coneMatcher",
        "nonConeMatcher",
        "compileGlob",
        "bindRebaseNamespace",
        "consoleProgress",

        "tarArchive",
        "zipArchive",
        "streamBlob",
        "catFileBatch",
        "map",
        "filter",
        "find",
        "flatMap",
        "join",
        "innerJoin",
        "groupBy",
        "stream",
        "pushAll",
        "commitDateWalk",
        "assertOrdered",
        "trackedRange",
        "trackedPipeline4",
        "pullCounter",
        "throwingAt",
        "awaitable",
        "abortableRange"
      ]
    },
    "integrationProof": {
      "tier": "integration",
      "buckets": [
        "real-fs",
        "real-http",
        "real-process",
        "cross-tool-interop",
        "platform-only",
        "multi-adapter-parity",
        "coverage-gap"
      ],
      "surfaceRegex": "^[a-z][a-zA-Z0-9.-]{1,40}$",
      "uniqueMinLength": 12,
      "uniqueMaxLength": 200,
      "directoryRules": {
        "real-http": ["network/"],
        "real-fs": ["root", "posix-only/", "win-only/"],
        "real-process": ["posix-only/", "win-only/"],
        "platform-only": ["posix-only/", "win-only/"],
        "cross-tool-interop": ["root"],
        "multi-adapter-parity": ["root"],
        "coverage-gap": ["root"]
      }
    }
  },
  "gating": {
    "overMockedIntegration": false,
    "underAssertedUnit": true,
    "gwtTitle": true,
    "aaaBody": true,
    "sutNaming": true,
    "bareClassToThrow": true,
    "emptyAaaSection": true,
    "integrationProof": false,
    "sutBindsResult": true
  },
  "excludePaths": [
    "tooling/test/unit/test-pyramid/detect-*.test.ts",
    "tooling/test/unit/test-pyramid/parse-manifest.test.ts",
    "tooling/test/unit/test-pyramid/parse-proves-header.test.ts",
    "tooling/test/unit/test-pyramid/render-report.test.ts",
    "tooling/test/unit/test-pyramid/scan-it-blocks.test.ts",
    "tooling/test/unit/test-pyramid/scan-describe-blocks.test.ts",
    "tooling/test/integration/audit-test-pyramid.test.ts",
    "tooling/test/integration/audit-browser-surface.test.ts",
    "tooling/test/integration/audit-write-surfaces.test.ts",
    "tooling/test/integration/check-mutation-budgets.test.ts",
    "tooling/test/integration/compute-mutation-scope.test.ts",
    "tooling/test/integration/has-code-changes.test.ts"
  ]
}
